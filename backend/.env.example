# Copy to .env and fill in
DATABASE_URL=postgresql://postgres:your-password@localhost:5432/portfolio
TEST_DATABASE_URL=postgresql://postgres:your-password@localhost:5432/portfolio_test
ALLOWED_ORIGINS=["http://localhost:3000"]
IP_HASH_SALT=any-long-random-string
MESSAGES_PER_HOUR_LIMIT=5

# Leave RESEND_API_KEY empty to only save messages without emailing them
RESEND_API_KEY=
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
CONTACT_INBOX_EMAIL=you@example.com

# Simbha chatbot. Locally always use Groq's free tier; the app refuses to start with "anthropic" outside Vercel.
# The Claude key and SIMBHA_LLM_PROVIDER=anthropic are set only in Vercel's environment variables, never here.
SIMBHA_LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
VOYAGE_API_KEY=
# Spending guards: false turns Simbha off with zero API calls; limits are per visitor, the daily one is for the whole site
SIMBHA_ENABLED=true
SIMBHA_QUESTIONS_PER_MINUTE_LIMIT=5
SIMBHA_QUESTIONS_PER_HOUR_LIMIT=20
SIMBHA_QUESTIONS_PER_DAY_LIMIT=200
